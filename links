// =====================================
// ساخت لینک زمان‌دار واقعی
// =====================================

async function createTimedLink(
  ctx,
  hours
) {

  const validHours =
    Math.min(
      24,
      Math.max(
        1,
        Number(hours) || 1
      )
    );

  const expireDate =
    Math.floor(
      Date.now() / 1000
    ) +
    (
      validHours *
      60 *
      60
    );

  const result =
    await ctx.telegram
      .createChatInviteLink(
        ctx.chat.id,
        {
          name:
            `${validHours} ساعت`,

          expire_date:
            expireDate
        }
      );

  return result.invite_link;
}


