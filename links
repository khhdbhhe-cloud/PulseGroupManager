function getManagerAccess(
  group,
  userId
) {

  const links =
    getLinkData(group);

  return (
    links.managers[
      String(userId)
    ] === true
  );
}


// =====================================
// نمایش نام کاربر
// =====================================

function getUserName(user) {

  if (!user) {
    return "کاربر";
  }

  if (user.username) {
    return `@${user.username}`;
  }

  const first =
    user.first_name || "";

  const last =
    user.last_name || "";

  const full =
    `${first} ${last}`.trim();

  return full || "کاربر";
}


