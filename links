        getLinkData(group);

      // اگر دریافت لینک بسته باشد
      // کاربران عادی هیچ پاسخی نمی‌گیرند
      if (!links.receiveEnabled) {
        return;
      }

      const requested =
        ctx.match &&
        ctx.match[1]
          ? Number(ctx.match[1])
          : Number(
              links.receiveDuration || 1
            );

      if (
        !Number.isFinite(requested) ||
        requested <= 0 ||
        requested > 24
      ) {
        return;
