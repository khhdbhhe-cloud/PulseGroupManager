// =====================================
// بررسی پنل خصوصی
// =====================================

async function validatePanel(
  ctx,
  ownerId,
  requiredType = null
) {

  if (!ctx.callbackQuery) {
    return false;
  }

  if (
    !isPanelOwner(
      ctx,
      ownerId
    )
  ) {
    return false;
  }

  const message =
    ctx.callbackQuery.message;

  if (!message) {
    return false;
  }

  const panel =
    getPanel(
      message.chat.id,
      message.message_id
    );

  if (!panel) {
    return false;
  }

  if (
    String(panel.ownerId) !==
    String(ownerId)
  ) {
    return false;
  }

  if (
    requiredType &&
    panel.type !== requiredType
  ) {
    return false;
  }

  if (
    panel.type === "manager"
  ) {

    const access =
      await hasLinkManagementAccess(
        ctx,
        ctx.from.id
      );

    if (!access) {
      return false;
    }
  }

  return true;
}// =====================================
// ثبت قابلیت‌های لینک
// =====================================

function registerLinks(bot) {

  // ===================================
  // فرمان «لینک»
  // فقط مالک یا مدیر دارای دسترسی
  // ===================================

  bot.hears(
    /^لینک$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      const allowed =
        await hasLinkManagementAccess(
          ctx
        );

      // کاربر عادی کاملاً ساکت
      if (!allowed) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      getLinkData(group);

      saveDB();

      const owner =
        await isOwner(ctx);

      const type =
        owner
          ? "owner"
          : "manager";

      const keyboard =
        owner
          ? pageOneKeyboard(
              ctx.from.id
            )
          : managerPanelKeyboard(
              ctx.from.id,
              group
            );

      const panel =
        await ctx.reply(
          mainPanelText(),
          {
            reply_markup:
              keyboard
          }
        );

      rememberPanel(
        ctx.chat.id,
        panel.message_id,
        ctx.from.id,
        type
      );
    }
  );


  // ===================================
  // فرمان دریافت لینک
  // اعضا، مدیران و مالک
  // فقط وقتی دریافت لینک باز باشد
  // ===================================

  bot.hears(
    /^دریافت لینک(?:\s+(\d+))?$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      const links =
        getLinkData(group);

      // اگر بسته باشد هیچ جوابی
      if (!links.receiveEnabled) {
        return;
      }

      const requested =
        ctx.match &&
        ctx.match[1]
          ? Number(ctx.match[1])
          : links.receiveDuration;

      const hours =
        Math.min(
          24,
          Math.max(
            1,
            Number(requested) ||
              links.receiveDuration
          )
        );

      try {

        const link =
          await createReceiveLink(
            ctx,
            hours
          );

        await replyToCommand(
          ctx,
          [
            "『𓆩 لینک دریافت 𓆪』",
            "",
            link,
            "",
            `مدت اعتبار: ${hours} ساعت`
          ].join("\n")
        );

      } catch (error) {

        console.error(
          "RECEIVE LINK ERROR:",
          error
        );

        // اینجا هم چون فرمان عمومی است
        // فقط در صورت خطای واقعی پاسخ می‌دهیم
        try {
          await replyToCommand(
            ctx,
            "خطا در ساخت لینک دریافت."
          );
        } catch (_) {}
      }
    }
  );


  // ===================================
  // دسترسی اختصاصی مدیر
  // فقط مالک + فقط Reply
  // ===================================

  bot.hears(
    /^دسترسی لینک$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      const owner =
        await isOwner(ctx);

      if (!owner) {
        return;
      }

      // بدون Reply = سکوت کامل
      if (
        !ctx.message.reply_to_message
      ) {
        return;
      }

      const target =
        ctx.message.reply_to_message
          .from;

      if (!target) {
        return;
      }

      const role =
        await getMemberRole(
          ctx,
          target.id
        );

      // فقط مدیر می‌تواند مدیر لینک شود
      if (
        role !== "administrator"
      ) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      const links =
        getLinkData(group);

      links.managers[
        target.id
      ] = true;

      saveDB();

      await replyToCommand(
        ctx,
        `دسترسی لینک برای ${getUserName(target)} فعال شد.`
      );
    }
  );


  // ===================================
  // حذف دسترسی اختصاصی مدیر
  // فقط مالک + فقط Reply
  // ===================================

  bot.hears(
    /^حذف دسترسی لینک$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      const owner =
        await isOwner(ctx);

      if (!owner) {
        return;
      }

      // بدون Reply = سکوت کامل
      if (
        !ctx.message.reply_to_message
      ) {
        return;
      }

      const target =
        ctx.message.reply_to_message
          .from;

      if (!target) {
        return;
      }

      const role =
        await getMemberRole(
          ctx,
          target.id
        );

      if (
        role !== "administrator"
      ) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      const links =
        getLinkData(group);

      delete links.managers[
        target.id
      ];

      saveDB();

      await replyToCommand(
        ctx,
        `دسترسی لینک ${getUserName(target)} حذف شد.`
      );
    }
  );


  // ===================================
  // دسترسی همه مدیران
  // فقط مالک + فقط Reply
  // ===================================

  bot.hears(
    /^دسترسی لینک مدیران$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      const owner =
        await isOwner(ctx);

      if (!owner) {
        return;
      }

      // تأکید: این فرمان هم Reply لازم دارد
      if (
        !ctx.message.reply_to_message
      ) {
        return;
      }

      const target =
        ctx.message.reply_to_message
          .from;

      if (!target) {
        return;
      }

      const role =
        await getMemberRole(
          ctx,
          target.id
        );

      if (
        role !== "administrator"
      ) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      const links =
        getLinkData(group);

      links.allManagersAccess =
        true;

      saveDB();

      await replyToCommand(
        ctx,
        "دسترسی لینک برای همه مدیران فعال شد."
      );
    }
  );


  // ===================================
  // حذف دسترسی همه مدیران
  // فقط مالک + فقط Reply
  // ===================================

  bot.hears(
    /^حذف دسترسی همه مدیران$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      const owner =
        await isOwner(ctx);

      if (!owner) {
        return;
      }

      // Reply اجباری
      if (
        !ctx.message.reply_to_message
      ) {
        return;
      }

      const target =
        ctx.message.reply_to_message
          .from;

      if (!target) {
        return;
      }

      const role =
