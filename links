// =====================================
// بررسی امنیت پنل
// =====================================

async function validatePanel(
  ctx,
  ownerId,
  requiredType = null
) {

  if (!ctx.callbackQuery) {
    return false;
  }

  if (
    String(ctx.from.id) !==
    String(ownerId)
  ) {
    return false;
  }

  const message =
    ctx.callbackQuery.message;

  if (!message) {
    return false;
  }

  const panel =
    getPanel(
      message.chat.id,
      message.message_id
    );

  if (!panel) {
    return false;
  }

  if (
    String(panel.ownerId) !==
    String(ownerId)
  ) {
    return false;
  }

  if (
    requiredType &&
    panel.type !== requiredType
  ) {
    return false;
  }

  if (panel.type === "manager") {

    const access =
      await hasLinkManagementAccess(
        ctx,
        ctx.from.id
      );

    if (!access) {
      return false;
    }
  }

  return true;
}


// =====================================
// ثبت لینک‌ها
// =====================================

function registerLinks(bot) {

  // ===================================
  // فرمان لینک
  // پنل حتماً Reply می‌شود
  // ===================================

  bot.hears(
    /^لینک$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      const allowed =
        await hasLinkManagementAccess(
          ctx
        );

      // کاربر عادی:
      // هیچ پیام
      if (!allowed) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      getLinkData(group);
      saveDB();

      const owner =
        await isOwner(ctx);

      const type =
        owner
          ? "owner"
          : "manager";

      const keyboard =
        owner
          ? pageOneKeyboard(
              ctx.from.id
            )
          : managerPanelKeyboard(
              ctx.from.id,
              group
            );

      // پنل Reply به خود فرمان لینک
      const panel =
        await replyToCommand(
          ctx,
          mainPanelText(),
          {
            reply_markup:
              keyboard
          }
        );

      if (panel) {

        rememberPanel(
          ctx.chat.id,
          panel.message_id,
          ctx.from.id,
          type
        );
      }
    }
  );


  // ===================================
  // دریافت لینک
  // برای استفاده عمومی
  // ===================================

  bot.hears(
    /^دریافت لینک(?:\s+(\d+))?$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      const links =
        getLinkData(group);

      // بسته باشد = سکوت
      if (!links.receiveEnabled) {
        return;
      }

      let hours =
        links.receiveDuration;

      if (
        ctx.match &&
        ctx.match[1]
      ) {

        hours =
          Number(
            ctx.match[1]
          );
      }

      hours =
        Math.min(
          24,
          Math.max(
            1,
            Number(hours) || 1
          )
        );

      try {

        const link =
          await createReceiveLink(
            ctx,
            hours
          );

        await replyToCommand(
          ctx,
          [
            "『𓆩 لینک دریافت 𓆪』",
            "",
            link,
            "",
            `مدت اعتبار: ${hours} ساعت`
          ].join("\n")
        );

      } catch (error) {

        await sendLinkError(
          ctx,
          error
        );
      }
    }
  );  // ===================================
  // دسترسی لینک
  // فقط مالک + حتماً Reply
  // ===================================

  bot.hears(
    /^دسترسی لینک$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      if (
        !(await isOwner(ctx))
      ) {
        return;
      }

      // بدون Reply = هیچ پیام
      if (
        !ctx.message.reply_to_message
      ) {
        return;
      }

      const target =
        ctx.message.reply_to_message
          .from;

      if (!target) {
        return;
      }

      const role =
        await getMemberRole(
          ctx,
          target.id
        );

      if (
        role !== "administrator"
      ) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      const links =
        getLinkData(group);

      links.managers[
        target.id
      ] = true;

      saveDB();

      await replyToCommand(
        ctx,
        `دسترسی لینک برای ${getUserName(target)} فعال شد.`
      );
    }
  );


  // ===================================
  // حذف دسترسی لینک
  // فقط مالک + حتماً Reply
  // ===================================

  bot.hears(
    /^حذف دسترسی لینک$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      if (
        !(await isOwner(ctx))
      ) {
        return;
      }

      if (
        !ctx.message.reply_to_message
      ) {
        return;
      }

      const target =
        ctx.message.reply_to_message
          .from;

      if (!target) {
        return;
      }

      const role =
        await getMemberRole(
          ctx,
          target.id
        );

      if (
        role !== "administrator"
      ) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      const links =
        getLinkData(group);

      delete links.managers[
        target.id
      ];

      saveDB();

      await replyToCommand(
        ctx,
        `دسترسی لینک ${getUserName(target)} حذف شد.`
      );
    }
  );


  // ===================================
  // دسترسی لینک مدیران
  // فقط مالک + Reply
  // ===================================

  bot.hears(
    /^دسترسی لینک مدیران$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      if (
        !(await isOwner(ctx))
      ) {
        return;
      }

      // حتی این فرمان هم Reply اجباری است
      if (
        !ctx.message.reply_to_message
      ) {
        return;
      }

      const target =
        ctx.message.reply_to_message
          .from;

      if (!target) {
        return;
      }

      const role =
        await getMemberRole(
          ctx,
          target.id
        );

      if (
        role !== "administrator"
      ) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      const links =
        getLinkData(group);

      links.allManagersAccess =
        true;

      saveDB();

      await replyToCommand(
        ctx,
        "دسترسی لینک برای همه مدیران فعال شد."
      );
    }
  );


  // ===================================
  // حذف دسترسی همه مدیران
  // فقط مالک + Reply
  // ===================================

  bot.hears(
    /^حذف دسترسی همه مدیران$/i,
    async (ctx) => {

      if (!isGroupChat(ctx)) {
        return;
      }

      if (
        !(await isOwner(ctx))
      ) {
        return;
      }

      // Reply اجباری
      if (
        !ctx.message.reply_to_message
      ) {
        return;
      }

      const target =
        ctx.message.reply_to_message
          .from;

      if (!target) {
        return;
      }

      const role =
        await getMemberRole(
          ctx,
          target.id
        );

      if (
        role !== "administrator"
      ) {
        return;
      }

      const group =
        getGroup(
          ctx.chat.id
        );

      const links =
        getLinkData(group);

      links.allManagersAccess =
        false;

      saveDB();

