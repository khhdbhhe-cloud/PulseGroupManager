const openedPanels = {};


// =====================================
// بررسی گروه
// =====================================

function isGroupChat(ctx) {
  if (!ctx || !ctx.chat) return false;

  return (
    ctx.chat.type === "group" ||
    ctx.chat.type === "supergroup"
  );
}


// =====================================
// گرفتن نقش کاربر
// =====================================

async function getMemberRole(ctx, userId) {
  try {
    const member =
      await ctx.telegram.getChatMember(
        ctx.chat.id,
        userId
      );

    return member.status;
  } catch (error) {
    return null;
  }
}


// =====================================
// اطلاعات لینک گروه
// =====================================

function getLinkData(group) {

  if (!group.links) {
    group.links = {
      main: null,
      oneTime: null,
      timed: [],
      location: null,
      approval: null,
      request: null,

      receiveEnabled: false,
      receiveDuration: 1,

      timedDuration: 24,

      allManagersAccess: false,
      managers: {}
    };
  }

  if (!group.links.managers) {
    group.links.managers = {};
  }

  if (!Array.isArray(group.links.timed)) {
    group.links.timed = [];
  }

  if (
    typeof group.links.receiveEnabled !==
    "boolean"
  ) {
    group.links.receiveEnabled = false;
  }

  if (
    !Number.isInteger(
      Number(group.links.receiveDuration)
    ) ||
    Number(group.links.receiveDuration) < 1 ||
    Number(group.links.receiveDuration) > 24
  ) {
    group.links.receiveDuration = 1;
  }

  if (
    !Number.isInteger(
      Number(group.links.timedDuration)
    ) ||
    Number(group.links.timedDuration) < 1 ||
    Number(group.links.timedDuration) > 24
  ) {
    group.links.timedDuration = 24;
  }

  if (
    typeof group.links.allManagersAccess !==
    "boolean"
  ) {
    group.links.allManagersAccess = false;
  }

  return group.links;
}


// =====================================
// بررسی مالک گروه
// =====================================

async function isOwner(ctx, userId = null) {

  if (!isGroupChat(ctx)) {
    return false;
  }

  const id =
    userId || ctx.from.id;

  const role =
    await getMemberRole(
      ctx,
      id
    );

  return role === "creator";
}


// =====================================
// بررسی دسترسی مدیریت لینک
// =====================================

async function hasLinkManagementAccess(
  ctx,
  userId = null
) {

  if (!isGroupChat(ctx)) {
    return false;
  }

  const id =
    userId || ctx.from.id;

  const role =
    await getMemberRole(
      ctx,
      id
    );

  // مالک همیشه دسترسی کامل دارد
  if (role === "creator") {
    return true;
  }

  // فقط مدیر می‌تواند دسترسی داشته باشد
  if (role !== "administrator") {
    return false;
  }

  const group =
    getGroup(ctx.chat.id);

  const links =
    getLinkData(group);

  // دسترسی عمومی مدیران
  if (links.allManagersAccess) {
    return true;
  }

  // دسترسی اختصاصی
  return (
    links.managers[id] === true
  );
}


// =====================================
// بررسی مدیر مجاز لینک
// =====================================

async function checkLinkManager(ctx) {

  return await hasLinkManagementAccess(
    ctx,
    ctx.from.id
  );
}


// =====================================
// نام کاربر
// =====================================

function getUserName(user) {

  if (!user) {
    return "کاربر";
  }

  const name = [
    user.first_name || "",
    user.last_name || ""
  ]
    .join(" ")
    .trim();

  return (
    name ||
    user.username ||
    "کاربر"
  );
}


// =====================================
// Reply واقعی به پیام فرمان
// =====================================

async function replyToCommand(
  ctx,
  text,
  extra = {}
) {

  if (
    !ctx ||
    !ctx.message ||
    !ctx.message.message_id
  ) {
    return null;
  }

  return await ctx.telegram.sendMessage(
    ctx.chat.id,
    text,
    {
      ...extra,

      reply_parameters: {
        message_id:
          ctx.message.message_id
      }
    }
  );
}


// =====================================
// ذخیره پنل
// =====================================

function rememberPanel(
  chatId,
  messageId,
  ownerId,
  type
) {

  openedPanels[
    `${chatId}:${messageId}`
  ] = {
    ownerId: String(ownerId),
    type: type,
    createdAt: Date.now()
  };
}


// =====================================
// گرفتن پنل
// =====================================

function getPanel(
  chatId,
  messageId
) {

  return (
    openedPanels[
      `${chatId}:${messageId}`
    ] || null
  );
}


// =====================================
// حذف پنل
// =====================================

function removePanel(
  chatId,
  messageId
) {

  delete openedPanels[
    `${chatId}:${messageId}`
  ];
}


// =====================================
// پاکسازی پنل‌های قدیمی
// =====================================

function cleanOldPanels() {

  const now =
    Date.now();

  for (
    const key of Object.keys(
      openedPanels
    )
  ) {

    if (
      now -
      openedPanels[key].createdAt >
      30 * 60 * 1000
    ) {
      delete openedPanels[key];
    }
  }
}


