// =====================================
// انتخاب مدت دریافت
// 1 تا 24 ساعت
// =====================================

function receiveDurationKeyboard(
  ownerId
) {

  const rows = [];
  let row = [];

  for (
    let hour = 1;
    hour <= 24;
    hour++
  ) {

    row.push({
      text:
        `${hour} ساعت`,
      callback_data:
        `lnk_setduration:${ownerId}:${hour}`
    });

    if (row.length === 4) {
      rows.push(row);
      row = [];
    }
  }

  if (row.length) {
    rows.push(row);
  }

  rows.push([
    {
      text:
        "『𓆩 بازگشت 𓆪』",
      callback_data:
        `lnk_page2:${ownerId}`
    }
  ]);

  return {
    inline_keyboard:
      rows
  };
}


