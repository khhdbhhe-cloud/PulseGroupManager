const openedPanels = {};


// =====================================
// بررسی گروه
// =====================================

function isGroupChat(ctx) {

  if (!ctx.chat) {
    return false;
  }

  return (
    ctx.chat.type === "group" ||
    ctx.chat.type === "supergroup"
  );
}


// =====================================
// گرفتن نقش کاربر
// =====================================

async function getMemberRole(ctx, userId) {

  if (!userId) {
    return "unknown";
  }

  try {

    const member =
      await ctx.telegram.getChatMember(
        ctx.chat.id,
        userId
      );

    if (!member) {
      return "unknown";
    }

    if (member.status === "creator") {
      return "owner";
    }

    if (member.status === "administrator") {
      return "admin";
    }

    if (
      member.status === "member" ||
      member.status === "restricted"
    ) {
      return "member";
    }

    if (member.status === "left") {
      return "left";
    }

    if (member.status === "kicked") {
      return "kicked";
    }

    return "unknown";

  } catch (error) {

    console.error(
      "links getMemberRole:",
      error.message
    );

    return "unknown";
  }
}


// =====================================
// گرفتن اطلاعات لینک گروه
// =====================================

function getLinkData(group) {

  if (!group.links) {

    group.links = {
      main: null,
      oneTime: null,
      timed: [],
      location: null,
      approval: null,
      request: null,

      receiveEnabled: false,
      receiveDuration: 1,

      managers: {}
    };
  }


  if (!Array.isArray(group.links.timed)) {
    group.links.timed = [];
  }


  if (
    typeof group.links.receiveEnabled !== "boolean"
  ) {
    group.links.receiveEnabled = false;
  }


  if (
    !Number.isFinite(
      Number(group.links.receiveDuration)
    )
  ) {
    group.links.receiveDuration = 1;
  }


  if (!group.links.managers) {
    group.links.managers = {};
  }


  return group.links;
}


// =====================================
// آیا کاربر مالک است؟
// =====================================

async function isOwner(ctx) {

  if (!ctx.from) {
    return false;
  }

  return (
    await getMemberRole(
      ctx,
      ctx.from.id
    )
  ) === "owner";
}


// =====================================
// آیا کاربر مدیر دارای دسترسی لینک است؟
/*
  مالک همیشه دسترسی کامل دارد.

  مدیر عادی فقط زمانی دسترسی دارد
  که مالک آن را فعال کرده باشد.
*/
// =====================================

async function hasLinkManagementAccess(
  ctx,
  userId = null
) {

  const id =
    userId ||
    (ctx.from && ctx.from.id);

  if (!id) {
    return false;
  }

  const role =
    await getMemberRole(
      ctx,
      id
    );

  if (role === "owner") {
    return true;
  }

  if (role !== "admin") {
    return false;
  }

  const group =
    getGroup(ctx.chat.id);

  const links =
    getLinkData(group);

  return (
    links.managers[String(id)] === true
  );
}


// =====================================
// بررسی دسترسی مدیریت لینک
// کاربران عادی کاملاً ساکت
// =====================================

async function checkLinkManager(ctx) {

  if (!isGroupChat(ctx)) {
    return false;
  }

  if (!ctx.from || !ctx.from.id) {
    return false;
  }

  return await hasLinkManagementAccess(
    ctx,
    ctx.from.id
  );
}


// =====================================
// بررسی صاحب پنل
// =====================================

function isPanelOwner(
  ctx,
  ownerId
) {

  if (!ctx.from || !ownerId) {
    return false;
  }

  return (
    Number(ctx.from.id) ===
    Number(ownerId)
  );
}


// =====================================
// ذخیره پنل
// =====================================

function rememberPanel(
  chatId,
  messageId,
  ownerId
) {

  const key =
    `${chatId}:${messageId}`;

  openedPanels[key] = {
    chatId,
    messageId,
    ownerId,
    createdAt: Date.now()
  };
}


// =====================================
// گرفتن پنل
// =====================================

function getPanel(
  chatId,
  messageId
) {

  const key =
    `${chatId}:${messageId}`;

  return openedPanels[key] || null;
}


// =====================================
// حذف پنل
// =====================================

function removePanel(
  chatId,
  messageId
) {

  const key =
    `${chatId}:${messageId}`;

  delete openedPanels[key];
}


// =====================================
// پاکسازی پنل‌های قدیمی
// =====================================

function cleanOldPanels() {

  const now =
    Date.now();

  const maxAge =
    30 * 60 * 1000;

  for (
    const key of Object.keys(openedPanels)
  ) {

    if (
      now -
      openedPanels[key].createdAt >
      maxAge
    ) {

      delete openedPanels[key];
    }
  }
}


// =====================================
// Reply به پیام اصلی
// =====================================

async function replyToCommand(
  ctx,
  text,
  extra = {}
) {

  if (
    ctx.message &&
    ctx.message.message_id
  ) {

    return ctx.reply(
      text,
      {
        ...extra,
        reply_parameters: {
          message_id:
            ctx.message.message_id
        }
      }
    );
  }

  return ctx.reply(
    text,
    extra
  );
}


// =====================================
// بررسی دسترسی ربات برای لینک
// =====================================

async function checkBotInviteAccess(ctx) {

  try {

    const botId =
      ctx.botInfo &&
      ctx.botInfo.id;

    if (!botId) {
      return false;
    }

    const member =
      await ctx.telegram.getChatMember(
        ctx.chat.id,
        botId
      );

    if (
      !member ||
      (
        member.status !== "administrator" &&
        member.status !== "creator"
      )
    ) {
      return false;
    }

    if (
      member.status === "creator" ||
      member.can_invite_users
    ) {
      return true;
    }

    return false;

  } catch (error) {

    console.error(
      "links bot permission:",
      error.message
    );

    return false;
  }
}


