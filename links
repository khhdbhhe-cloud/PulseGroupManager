// =====================================
// ذخیره لینک
// =====================================

function saveLink(
  group,
  type,
  value
) {

  const links =
    getLinkData(group);

  links[type] =
    value;

  saveDB();
}


// =====================================
// فعال کردن دریافت لینک
// =====================================

function enableReceiveLink(
  group
) {

  const links =
    getLinkData(group);

  links.receiveEnabled =
    true;

  saveDB();
}


// =====================================
// بستن دریافت لینک
// =====================================

function disableReceiveLink(
  group
) {

  const links =
    getLinkData(group);

  links.receiveEnabled =
    false;

  saveDB();
}


// =====================================
// تنظیم مدت دریافت لینک
// =====================================

function setReceiveDuration(
  group,
  hours
) {

  const value =
    Number(hours);

  if (
    !Number.isFinite(value) ||
    value <= 0
  ) {
    return false;
  }

  const links =
    getLinkData(group);

  links.receiveDuration =
    Math.floor(value);

  saveDB();

  return true;
}


// =====================================
// تنظیم دسترسی مدیر
// =====================================

function setManagerAccess(
  group,
  userId,
  enabled
) {

  const links =
    getLinkData(group);

  links.managers[
    String(userId)
  ] = Boolean(enabled);

  saveDB();
}


// =====================================
