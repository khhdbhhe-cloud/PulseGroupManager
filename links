const openedPanels = {};


// =====================================
// بررسی گروه بودن چت
// =====================================

function isGroupChat(ctx) {
  if (!ctx || !ctx.chat) return false;

  return (
    ctx.chat.type === "group" ||
    ctx.chat.type === "supergroup"
  );
}


// =====================================
// گرفتن نقش کاربر
// =====================================

async function getMemberRole(ctx, userId) {
  try {
    const member = await ctx.telegram.getChatMember(
      ctx.chat.id,
      userId
    );

    return member.status;
  } catch (error) {
    return null;
  }
}


// =====================================
// گرفتن اطلاعات لینک گروه
// =====================================

function getLinkData(group) {

  if (!group.links) {
    group.links = {
      main: null,
      oneTime: null,
      timed: [],
      location: null,

      approval: null,
      request: null,

      receiveEnabled: false,
      receiveDuration: 1,

      timedDuration: 24,

      allManagersAccess: false,
      managers: {}
    };
  }

  if (!group.links.managers) {
    group.links.managers = {};
  }

  if (typeof group.links.receiveEnabled !== "boolean") {
    group.links.receiveEnabled = false;
  }

  if (!group.links.receiveDuration) {
    group.links.receiveDuration = 1;
  }

  if (!group.links.timedDuration) {
    group.links.timedDuration = 24;
  }

  if (typeof group.links.allManagersAccess !== "boolean") {
    group.links.allManagersAccess = false;
  }

  if (!Array.isArray(group.links.timed)) {
    group.links.timed = [];
  }

  return group.links;
}


// =====================================
// بررسی مالک
// =====================================

async function isOwner(ctx, userId = null) {

  if (!isGroupChat(ctx)) {
    return false;
  }

  const id = userId || ctx.from.id;

  const role = await getMemberRole(
    ctx,
    id
  );

  return (
    role === "creator"
  );
}


// =====================================
// بررسی دسترسی مدیریت لینک
// =====================================

async function hasLinkManagementAccess(
  ctx,
  userId = null
) {

  if (!isGroupChat(ctx)) {
    return false;
  }

  const id = userId || ctx.from.id;

  const role = await getMemberRole(
    ctx,
    id
  );

  // مالک همیشه دسترسی دارد
  if (role === "creator") {
    return true;
  }

  // فقط مدیر می‌تواند دسترسی لینک داشته باشد
  if (
    role !== "administrator"
  ) {
    return false;
  }

  const group = getGroup(
    ctx.chat.id
  );

  const links = getLinkData(
    group
  );

  // دسترسی همه مدیران
  if (links.allManagersAccess) {
    return true;
  }

  // دسترسی اختصاصی مدیر
  return (
    links.managers[id] === true
  );
}


// =====================================
// بررسی مدیر لینک
// =====================================

async function checkLinkManager(ctx) {

  if (!isGroupChat(ctx)) {
    return false;
  }

  return await hasLinkManagementAccess(
    ctx,
    ctx.from.id
  );
}


// =====================================
// بررسی مالک پنل
// =====================================

function isPanelOwner(
  ctx,
  ownerId
) {

  if (!ctx || !ctx.from) {
    return false;
  }

  return String(ctx.from.id) ===
    String(ownerId);
}


// =====================================
// ثبت پنل باز شده
// =====================================

function rememberPanel(
  chatId,
  messageId,
  ownerId,
  type
) {

  const key =
    `${chatId}:${messageId}`;

  openedPanels[key] = {
    ownerId: String(ownerId),
    type: type || "owner",
    createdAt: Date.now()
  };
}


// =====================================
// گرفتن پنل
// =====================================

function getPanel(
  chatId,
  messageId
) {

  const key =
    `${chatId}:${messageId}`;

  return openedPanels[key] || null;
}


// =====================================
// حذف پنل
// =====================================

function removePanel(
  chatId,
  messageId
) {

  const key =
    `${chatId}:${messageId}`;

  delete openedPanels[key];
}


// =====================================
// پاک کردن پنل‌های قدیمی
// =====================================

function cleanOldPanels() {

  const now = Date.now();

  for (
    const key of Object.keys(openedPanels)
  ) {

    if (
      now -
      openedPanels[key].createdAt >
      30 * 60 * 1000
    ) {
      delete openedPanels[key];
    }
  }
}


// =====================================
// پاسخ به فرمان
// همیشه Reply
// =====================================

async function replyToCommand(
  ctx,
  text,
  extra = {}
) {

  if (!ctx.message) {
    return null;
  }

  return await ctx.reply(
    text,
    {
      ...extra,
      reply_parameters: {
        message_id: ctx.message.message_id
      }
    }
  );
}


// =====================================
// نام کاربر
// =====================================

function getUserName(user) {

  if (!user) {
    return "کاربر";
  }

  const first =
    user.first_name || "";

  const last =
    user.last_name || "";

  const full =
    `${first} ${last}`.trim();

  return (
    full ||
    user.username ||
    "کاربر"
  );
}


