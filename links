// =====================================
// ثبت سیستم لینک
// =====================================

function registerLinks(bot) {

  // ===================================
  // دستور اصلی «لینک»
  // ===================================

  bot.hears(
    /^لینک$/i,
    async ctx => {

      if (!await checkLinkManager(ctx)) {
        return;
      }

      cleanOldPanels();

      try {

        const ownerId =
          ctx.from.id;

        const sent =
          await ctx.reply(
            mainPanelText(),
            {
              reply_markup:
                pageOneKeyboard(
                  ownerId
                ),

              reply_parameters: {
                message_id:
                  ctx.message.message_id
              }
            }
          );

        rememberPanel(
          ctx.chat.id,
          sent.message_id,
          ownerId
        );

      } catch (error) {

        console.error(
          "links open:",
          error.message
        );
      }
    }
  );


  // ===================================
  // صفحه اول
  // ===================================

  bot.action(
    /^lnk_page1:(\d+)$/,
    async ctx => {

      const ownerId =
        Number(ctx.match[1]);

      if (
        !isPanelOwner(
          ctx,
          ownerId
        )
      ) {
        return;
      }

      if (
        !await checkLinkManager(ctx)
      ) {
        return;
      }

      try {

        await ctx.answerCbQuery();

        const panel =
          getPanel(
            ctx.chat.id,
            ctx.callbackQuery.message.message_id
          );

        if (!panel) {
          return;
        }

        await ctx.editMessageText(
          mainPanelText(),
          {
            reply_markup:
              pageOneKeyboard(
                ownerId
              )
          }
        );

