// =====================================
// ساخت لینک زمان‌دار
// =====================================

async function createTimedLink(
  ctx,
  hours
) {

  const value =
    Number(hours);

  if (
    !Number.isFinite(value) ||
    value <= 0
  ) {
    return null;
  }

  try {

    const expireDate =
      Math.floor(
        Date.now() / 1000
      ) +
      Math.floor(
        value * 60 * 60
      );

    return await ctx.telegram.createChatInviteLink(
      ctx.chat.id,
      {
        name:
          `${value} ساعت`,
        expire_date:
          expireDate
      }
    );

  } catch (error) {

    console.error(
      "createTimedLink:",
      error.message
    );

    return null;
  }
}


